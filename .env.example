# -----------------------------------------------------------------------------
# Notification Service Environment Configuration Template (.env.example)
# Note: In production, ENV=production rejects AUTH_MODE=dev and INTERNAL_EVENTS_ENABLED=true.
# -----------------------------------------------------------------------------

# Environment & Server
ENV=development
PORT=8085
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL Database Configuration
DATABASE_URL=postgres://notification_user:notification_pass@localhost:5432/notification_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Authentication & Security
AUTH_MODE=jwt
JWT_SECRET=super-secret-jwt-signing-key-change-in-prod
JWT_PUBLIC_KEY=
INTERNAL_SERVICE_TOKEN=internal-dev-token-change-in-prod
INTERNAL_EVENTS_ENABLED=true
WEBHOOK_SECRET=dev-webhook-secret-change-in-prod

# Email & Encryption
EMAIL_ENABLED=false
EMAIL_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY= # 32-byte Base64 key

# Kafka Consumer & Broker Settings
KAFKA_CONSUMER_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=notification-service
KAFKA_START_OFFSET=earliest
KAFKA_MAX_POLL_RECORDS=500
KAFKA_SESSION_TIMEOUT_MS=10000

# Kafka Security (PLAINTEXT locally, SASL_SSL in staging/production)
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TLS_CA_FILE=

# Kafka Consumed Domain Topics (Comma-separated)
KAFKA_TOPICS=erp.auth.events,erp.purchasing.events,erp.inventory.events,erp.sales.events,erp.returns.events,erp.finance.events,erp.platform.events

# Kafka Service-Owned Retry Topics (Comma-separated)
KAFKA_RETRY_TOPICS=erp.notification.retry.1m,erp.notification.retry.10m,erp.notification.retry.1h

# Kafka Dead Letter Queue Topic
KAFKA_DLQ_TOPIC=erp.notification.dlq
